{
  "entities": {
    "quiz": {
      "title": "Quiz",
      "description": "Naskah soal asesmen SMA Kurikulum Merdeka lengkap dengan stimulus, kunci jawaban, dan prompt visual AI.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1000 },
        "subject": { "type": "string", "maxLength": 128 },
        "targetLevel": { "type": "string", "maxLength": 64 },
        "fase": { "type": "string", "maxLength": 64 },
        "assessmentFocus": { "type": "string", "maxLength": 64 },
        "language": { "type": "string", "maxLength": 16 },
        "questions": { "type": "array" },
        "estimatedMinutes": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "subject", "questions", "createdAt"]
    },
    "userProfile": {
      "title": "UserProfile",
      "description": "Profil guru dan identitas satuan pendidikan (SMA).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "institution": { "type": "string", "maxLength": 256 },
        "subjectSpecialty": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "Dokumen profil guru dan sekolah pengguna"
    },
    "/users/{userId}/quizzes/{quizId}": {
      "schema": "quiz",
      "description": "Koleksi bank naskah soal ujian SMA milik guru"
    }
  }
}
